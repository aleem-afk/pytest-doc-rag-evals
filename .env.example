# Copy this file to ".env" and fill in the values there.
# .env is in .gitignore, so it never gets committed. Never put real keys in THIS file.

# Your OpenAI API key (from platform.openai.com -> API keys)
OPENAI_API_KEY=

# Which LLM provider to use (only "openai" is supported for now)
LLM_PROVIDER=openai

# Which model to use, e.g. a small, cheap one from OpenAI's pricing page
LLM_MODEL=gpt-5.4-mini
